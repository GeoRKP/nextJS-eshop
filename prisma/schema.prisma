generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Category (hierarchical) ───────────────────────────────────

model Category {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  nameEn        String?
  slug          String     @unique
  description   String?
  descriptionEn String?
  image         String?
  parentId      String?    @db.Uuid
  sortOrder     Int        @default(0)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now()) @db.Timestamp(6)
  updatedAt     DateTime   @updatedAt @db.Timestamp(6)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products        Product[]
  couponCategories CouponCategory[]

  @@index([parentId])
  @@index([sortOrder])
  @@index([parentId, isActive])
}

// ─── Product ───────────────────────────────────────────────────

model Product {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  nameEn           String?
  slug             String    @unique(map: "product_slug_idx")
  category         String
  categoryId       String?   @db.Uuid
  images           String[]
  brand            String
  description      String
  descriptionEn    String?
  stock            Int
  price            Decimal   @default(0) @db.Decimal(12, 2)
  rating           Decimal   @default(0) @db.Decimal(10, 2)
  numReviews       Int       @default(0)
  isFeatured       Boolean   @default(false)
  banner           String?
  specs            Json?     @db.Json
  lowStockThreshold Int      @default(5)
  deletedAt        DateTime? @db.Timestamp(6)
  createdAt        DateTime  @default(now()) @db.Timestamp(6)
  // Full-text search column (managed via custom migration / trigger)
  search_vector    Unsupported("tsvector")?

  categoryRef     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderitems      OrderItem[]
  Review          Review[]
  wishlistItems   WishlistItem[]
  couponProducts  CouponProduct[]
  priceHistory    PriceHistory[]

  @@index([categoryId])
  @@index([deletedAt])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([price])
  @@index([stock])
  @@index([rating])
  @@index([deletedAt, createdAt])
  @@index([deletedAt, isFeatured])
  @@index([deletedAt, category])
  @@index([deletedAt, price])
  @@index([deletedAt, rating])
  @@index([deletedAt, category, createdAt])
  @@index([deletedAt, brand])
}

// ─── User ──────────────────────────────────────────────────────

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String    @default("NO NAME")
  email           String    @unique(map: "user_email_idx")
  emailVerified   DateTime? @db.Timestamp(6)
  image           String?
  password        String?
  role            String    @default("user")
  address         Json?     @db.Json
  paymentMethod   String?
  deletedAt       DateTime? @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @db.Timestamp(6)
  // Trust & safety
  isBanned        Boolean   @default(false)
  bannedAt        DateTime? @db.Timestamp(6)
  bannedReason    String?
  suspendedUntil  DateTime? @db.Timestamp(6)
  suspendedReason String?
  // GDPR consent tracking
  marketingConsent Boolean  @default(false)
  // Guest checkout: shadow account created via "continue as guest" (no password)
  isGuest          Boolean  @default(false)

  Account       Account[]
  Session       Session[]
  Cart          Cart[]
  Order         Order[]
  Review        Review[]
  Wishlist      Wishlist?
  addresses     Address[]
  couponUsages  CouponUsage[]
  notifications Notification[]

  @@index([role])
  @@index([deletedAt])
  @@index([isBanned])
}

// ─── Auth models ───────────────────────────────────────────────

model Account {
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @id
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamp(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @db.Timestamp(6)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Email-based password reset (separate from VerificationToken which is OAuth-related)
model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@index([email])
  @@index([token])
}

// ─── Cart ──────────────────────────────────────────────────────

model Cart {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?  @db.Uuid
  sessionCartId  String
  items          Json[]   @default([]) @db.Json
  itemsPrice     Decimal  @default(0) @db.Decimal(12, 2)
  totalPrice     Decimal  @default(0) @db.Decimal(12, 2)
  shippingPrice  Decimal  @default(0) @db.Decimal(12, 2)
  taxPrice       Decimal  @default(0) @db.Decimal(12, 2)
  couponCode     String?
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionCartId])
  @@index([userId])
  // NOTE: a PARTIAL unique index on (sessionCartId) WHERE "userId" IS NULL is
  // enforced at the DB level (migration 20260718000000_add_cart_guest_unique).
  // Prisma can't express partial indexes, so it lives only in SQL.
}

// ─── Order ─────────────────────────────────────────────────────

model Order {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String      @db.Uuid
  shippingAddress   Json        @db.Json
  paymentMethod     String
  paymentResult     Json?       @db.Json
  itemsPrice        Decimal     @db.Decimal(12, 2)
  shippingPrice     Decimal     @db.Decimal(12, 2)
  taxPrice          Decimal     @db.Decimal(12, 2)
  totalPrice        Decimal     @db.Decimal(12, 2)
  isPaid            Boolean     @default(false)
  paidAt            DateTime?   @db.Timestamp(6)
  isDelivered       Boolean     @default(false)
  deliveredAt       DateTime?   @db.Timestamp(6)
  status            String      @default("pending")
  couponId          String?     @db.Uuid
  couponCode        String?
  discountAmount    Decimal     @default(0) @db.Decimal(12, 2)
  shippingAddressId String?     @db.Uuid
  createdAt         DateTime    @default(now()) @db.Timestamp(6)

  // Shipping method & Box Now (parcel-locker) fulfillment
  shippingMethod        String?  @default("home") // "home" | "boxnow_locker"
  boxnowLocker          Json?    @db.Json          // snapshot of the chosen APM locker
  boxnowReferenceNumber String?                    // delivery-request reference (== order id we send)
  boxnowParcelIds       String[] @default([])      // Box Now internal parcel ids
  boxnowStatus          String?                    // latest parcel status from Box Now

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderitems        OrderItem[]
  statusHistory     OrderStatusHistory[]
  coupon            Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  shippingAddr      Address?          @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  couponUsages      CouponUsage[]
  returnRequests    ReturnRequest[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([createdAt, isPaid])
  @@index([paymentMethod])
  @@index([shippingMethod])
}

model OrderItem {
  orderId   String  @db.Uuid
  productId String  @db.Uuid
  qty       Int
  price     Decimal @db.Decimal(12, 2)
  name      String
  slug      String
  image     String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([orderId, productId], map: "orderitems_orderId_productId_pk")
  @@index([productId])
  @@index([orderId])
}

// ─── Order Status History ──────────────────────────────────────

model OrderStatusHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String   @db.Uuid
  status    String
  note      String?
  changedBy String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderId, createdAt])
}

// ─── Review ────────────────────────────────────────────────────

model Review {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String         @db.Uuid
  productId          String         @db.Uuid
  rating             Int
  title              String
  description        String?
  isVerifiedPurchase Boolean        @default(true)
  isHidden           Boolean        @default(false)
  createdAt          DateTime       @default(now()) @db.Timestamp(6)
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product            Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  reports            ReviewReport[]

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
  @@index([productId, createdAt])
}

// ─── Review Report (moderation queue) ─────────────────────────
model ReviewReport {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId      String   @db.Uuid
  reason        String
  description   String?
  reporterEmail String
  status        String   @default("pending") // pending | resolved | dismissed
  createdAt     DateTime @default(now()) @db.Timestamp(6)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([status])
  @@index([status, createdAt])
}

// ─── Audit Log (admin action tracking) ─────────────────────────
model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  userName  String
  action    String   // e.g. "product.create", "user.ban", "order.refund"
  entity    String   // e.g. "Product", "Order", "User"
  entityId  String?
  details   Json?    @db.Json
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@index([entity, entityId])
}

// ─── System Settings (runtime config) ──────────────────────────
model SystemSetting {
  key       String   @id
  value     String
  type      String   @default("string") // string | number | boolean | json
  label     String?
  group     String   @default("general") // general | shipping | tax | email | maintenance | company
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  @@index([group])
}

// ─── Price History (Greek tax/audit compliance) ────────────────
model PriceHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @db.Uuid
  price      Decimal  @db.Decimal(12, 2)
  recordedAt DateTime @default(now()) @db.Timestamp(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, recordedAt])
}

// ─── Wishlist ──────────────────────────────────────────────────

model Wishlist {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @unique @db.Uuid
  createdAt DateTime       @default(now()) @db.Timestamp(6)
  updatedAt DateTime       @updatedAt @db.Timestamp(6)

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wishlistId String   @db.Uuid
  productId  String   @db.Uuid
  addedAt    DateTime @default(now()) @db.Timestamp(6)

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

// ─── Coupon / Discount ─────────────────────────────────────────

model Coupon {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String    @unique
  description     String?
  discountType    String    // "percentage" | "fixed_amount" | "free_shipping"
  discountValue   Decimal   @db.Decimal(12, 2)
  minOrderAmount  Decimal?  @db.Decimal(12, 2)
  maxDiscount     Decimal?  @db.Decimal(12, 2)
  maxUses         Int?
  maxUsesPerUser  Int       @default(1)
  usedCount       Int       @default(0)
  validFrom       DateTime  @db.Timestamp(6)
  validUntil      DateTime? @db.Timestamp(6)
  isActive        Boolean   @default(true)
  appliesToAll    Boolean   @default(true)
  createdAt       DateTime  @default(now()) @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @db.Timestamp(6)

  categories CouponCategory[]
  products   CouponProduct[]
  usages     CouponUsage[]
  orders     Order[]
}

model CouponCategory {
  couponId   String @db.Uuid
  categoryId String @db.Uuid

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId])
}

model CouponProduct {
  couponId  String @db.Uuid
  productId String @db.Uuid

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
}

model CouponUsage {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId String   @db.Uuid
  userId   String   @db.Uuid
  orderId  String   @db.Uuid
  usedAt   DateTime @default(now()) @db.Timestamp(6)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@index([userId])
}

// ─── Address Book ──────────────────────────────────────────────

model Address {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  label      String?
  fullName   String
  phone      String?
  address    String
  address2   String?
  city       String
  state      String?
  postalCode String
  country    String
  lat        Float?
  lng        Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @db.Timestamp(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@index([userId, isDefault])
  @@index([createdAt])
}

// ─── Return Requests ───────────────────────────────────────────

model ReturnRequest {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String    @db.Uuid
  userId       String    @db.Uuid
  status       String    @default("requested") // requested | approved | rejected | received | refunded
  reason       String
  description  String?
  images       String[]
  refundAmount Decimal?  @db.Decimal(12, 2)
  refundMethod String?
  adminNote    String?
  resolvedBy   String?   @db.Uuid
  resolvedAt   DateTime? @db.Timestamp(6)
  createdAt    DateTime  @default(now()) @db.Timestamp(6)
  updatedAt    DateTime  @updatedAt @db.Timestamp(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
}

// ─── Notification ──────────────────────────────────────────────

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  message   String
  data      Json?     @db.Json
  isRead    Boolean   @default(false)
  readAt    DateTime? @db.Timestamp(6)
  createdAt DateTime  @default(now()) @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}
